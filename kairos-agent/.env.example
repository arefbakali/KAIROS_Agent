# ============================================================
#  Choix du modèle — un seul fournisseur : Ollama, en local.
# ============================================================
LLM_PROVIDER=ollama

# Modèle installé via « ollama pull llama3.2:3b ».
LLM_MODEL=llama3.2:3b

# Ollama tourne en local, aucune clé nécessaire.
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
#  Divers
# ============================================================
FRONTEND_ORIGIN=http://localhost:5173
# Délai maximal (secondes) pour charger le modèle ou générer une réponse.
LLM_TIMEOUT=120

# ============================================================
#  Rappels e-mail (Gmail API — optionnel)
# ============================================================
# Client OAuth2 « Application Web » créé dans Google Cloud Console.
# Doit avoir les origines autorisées : http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/reminders/callback
