# ============================================================
#  KAIROS — variables Docker Compose (copier en .env)
#  Lues par docker-compose.yml uniquement. Les secrets du backend
#  restent dans kairos-agent/.env.
# ============================================================

# --- Modèle / Ollama ------------------------------------------
# Modèle téléchargé par ollama-pull ET utilisé par le backend.
LLM_MODEL=llama3.2:3b
# Version de l'image ollama/ollama.
OLLAMA_VERSION=0.32.1
# Par défaut : le conteneur ollama. Pour réutiliser un Ollama natif
# de l'hôte : http://host.docker.internal:11434 (voir DOCKER.md).
OLLAMA_BASE_URL=http://ollama:11434

# --- Ports publiés sur l'hôte ---------------------------------
# Changer FRONTEND_PORT impose de mettre à jour FRONTEND_ORIGIN
# (kairos-agent/.env) et les origines Google Cloud Console.
FRONTEND_PORT=5173
# Serveur : 127.0.0.1:8000 pour ne pas exposer le backend (Docker contourne ufw).
BACKEND_PORT=8000

# --- Build du frontend (valeurs publiques, intégrées au JS) ----
VITE_GOOGLE_CLIENT_ID=
# Local : http://localhost:8000 (appel direct au backend).
# Serveur : l'URL publique du frontend, ex. https://kairos.example.com
# (nginx relaie /api/* vers le backend, même origine).
VITE_AGENT_API_URL=http://localhost:8000
